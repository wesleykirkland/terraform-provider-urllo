#!/usr/bin/env python3
"""Runs before every commit. Installed automatically -- see the `hooks`
target in GNUmakefile, which points git's core.hooksPath at this directory
the first time anyone runs any `make` target in this clone. No manual
`pre-commit install` step required.

Only fast, credential-free checks run here (the same ones CI's "build" and
"unit" jobs require), plus the new-code coverage gate (`make cover-new`,
credential-free via the mock-backed acceptance tests -- see AGENTS.md for
the coverage policy it enforces). The repo-wide `make cover` floor and the
real (non-mock) acceptance tests stay CI-only since they need Urllo
credentials. Bypass with `git commit --no-verify` if you really need to.

Plain Python (no bash) so this works the same for Windows contributors,
who may not have a POSIX shell on PATH.
"""

from __future__ import annotations

import shutil
import subprocess
import sys
from pathlib import Path


def repo_root() -> Path:
    out = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=True,
    )
    return Path(out.stdout.strip())


def run_step(root: Path, step: str, cmd: list[str]) -> int:
    print(f"pre-commit: {step}")
    return subprocess.run(cmd, cwd=root).returncode


def run_optional_step(root: Path, step: str, tool: str, cmd: list[str], install_hint: str) -> int:
    """Runs `cmd` (e.g. ["make", "lint"], which shells out to `tool`) if
    `tool` is resolvable, and returns 1 on failure. `mise` (this project's
    pinned toolchain manager, see mise.toml) is tried first even when `tool`
    is also on plain PATH, so the version that actually runs here matches
    what CI's jdx/mise-action pins -- not whatever happens to be globally
    installed. Soft-skips (returns 0) only when neither resolves `tool`,
    matching this hook's philosophy of never blocking a commit on a locally
    missing optional tool."""
    if shutil.which("mise"):
        return run_step(root, step, ["mise", "exec", "--", *cmd])
    if shutil.which(tool):
        return run_step(root, step, cmd)
    print(f"{tool} not found on PATH or via mise -- skipping locally (CI still runs it).", file=sys.stderr)
    print(f"Install: {install_hint}", file=sys.stderr)
    return 0


def main() -> int:
    root = repo_root()

    print("pre-commit: gofmt check")
    result = subprocess.run(
        ["gofmt", "-s", "-l", "-e", "."],
        cwd=root,
        capture_output=True,
        text=True,
    )
    if result.stdout.strip():
        print("gofmt found unformatted files (run 'make fmt' and stage the result):", file=sys.stderr)
        print(result.stdout, file=sys.stderr)
        return 1

    if run_optional_step(
        root, "lint", "golangci-lint", ["make", "lint"], "https://golangci-lint.run/welcome/install/ or `mise install`"
    ) != 0:
        return 1

    if run_step(root, "unit tests", ["make", "test"]) != 0:
        return 1

    if run_step(root, "new-code coverage", ["make", "cover-new"]) != 0:
        return 1

    if run_step(root, "govulncheck", ["make", "govulncheck"]) != 0:
        return 1

    if run_step(root, "doc completeness", ["make", "check-docs"]) != 0:
        return 1

    if run_step(root, "python tests", ["make", "test-py"]) != 0:
        return 1

    if run_optional_step(root, "python lint", "ruff", ["make", "lint-py"], "pip install ruff, or `mise install`") != 0:
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
